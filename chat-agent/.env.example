# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.3

# Token Exchange (Asgardeo)
# Your Asgardeo tenant's OAuth2 token endpoint
ASGARDEO_TOKEN_URL=https://api.asgardeo.io/t/your-tenant/oauth2/token/

# Meals Micro-App Backend
MEALS_BACKEND_URL=https://your-api-gateway.com/meals-app-backend/v1.0
# The OAuth2 client ID of the Meals app in Asgardeo (must have Token Exchange grant enabled)
MEALS_APP_CLIENT_ID=your-meals-app-client-id
# The OAuth2 client ID of the Guest Wi-Fi app in Asgardeo (must have Token Exchange grant enabled)
GUEST_WIFI_APP_CLIENT_ID=your-guest-wifi-app-client-id
# Guest Wi-Fi Micro-App Backend
GUEST_WIFI_BACKEND_URL=https://your-api-gateway.com/guest-wifi-backend/v1.0

# Leave Micro-App Backend
LEAVE_BACKEND_URL=https://your-api-gateway.com/leave-app/v1.0
LEAVE_APP_CLIENT_ID=your-leave-app-client-id

# Optional: additional scopes to append to the default ones (openid email groups profile)
MEALS_EXTRA_SCOPES=
GUEST_WIFI_EXTRA_SCOPES=

# Debug Mode (set to true for local development — adds x-jwt-assertion header)
DEBUG=false
