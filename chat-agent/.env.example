# OpenAI Configuration
OPENAI_API_KEY=sk-proj-your-openai-api-key
OPENAI_MODEL=gpt-4o

# Meals Micro-App Backend
MEALS_BACKEND_URL=https://your-api-gateway.com/meals-app-backend/v1.0

# Token Exchange (Asgardeo)
# Your Asgardeo tenant's OAuth2 token endpoint
ASGARDEO_TOKEN_URL=https://api.asgardeo.io/t/your-tenant/oauth2/token/
# The OAuth2 client ID of the Meals app in Asgardeo (must have Token Exchange grant enabled)
MEALS_APP_CLIENT_ID=your-meals-app-client-id
