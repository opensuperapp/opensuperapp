EXPO_PUBLIC_CLIENT_ID=<asgardeo-project-client-id> # Asgardeo Client ID
EXPO_PUBLIC_REDIRECT_URI=<redirect-uri>            # Redirect URI for authentication flow
EXPO_PUBLIC_TOKEN_URL=https://api.asgardeo.io/t/<asgardeo-organization>/oauth2/token
EXPO_PUBLIC_LOGOUT_URL=https://api.asgardeo.io/t/<asgardeo-organization>/oidc/logout
EXPO_PUBLIC_BACKEND_BASE_URL=<backend-url>         # Backend API Base URL
EXPO_PUBLIC_CHAT_AGENT_URL=<chat-agent-url>        # Chat agent API base URL (e.g. http://localhost:8000)

# Build-time switch for the "Save Business Card" wallet pass feature.
# The passes are fetched from the app backend, which proxies the wallet service,
# so there is no extra URL to set. Left unset/false, the wallet action is
# disabled in the app and no request is ever made.
# Per-OS rollout on top of this is done with Firebase Remote Config (see below).
EXPO_PUBLIC_ENABLE_WALLET_PASS=<true/false>

# Apple's pass type identifier, used only to ask iOS whether the business card
# is already in Apple Wallet (so the footer can offer "Open in Apple Wallet"
# instead of "Add") and to open it there. Must match APPLE_PASS_TYPE_ID in the
# wallet service; a mismatch silently reports the card as not installed. Unused
# on Android, where Google Wallet cannot be queried. Optional: left unset, the
# add button simply never turns into an open button.
EXPO_PUBLIC_APPLE_PASS_TYPE_ID=pass.com.wso2.businesscard

# Where "People Operations Data Protection Policy" links to on the consent
# sheet shown before a card is written to a wallet. That document is internal,
# so its address differs per deployment; unset, the link falls back to the
# public policy at https://wso2.com/privacy-policy.
EXPO_PUBLIC_EMPLOYEE_PRIVACY_POLICY_URL=<employee-privacy-policy-url>

# The business card (and with it, the wallet pass action above) is further
# gated behind the signed-in user's email domain AND group membership, both
# of which must match. Comma-separated; each defaults to a single WSO2 value
# when unset or empty (see notes below).
EXPO_PUBLIC_BUSINESS_CARD_ALLOWED_DOMAINS=wso2.com
EXPO_PUBLIC_BUSINESS_CARD_ALLOWED_GROUPS=wso2-employees

# Please note that this URL is required only for the WSO2 Super App.
EXPO_PUBLIC_LIBRARY_ARTICLE_FALLBACK_IMAGE=<fallback-image-url>

# Please note that the developer app-related URL is required only for the WSO2 Super App. 
EXPO_PUBLIC_DEVELOPER_APP_IOS_DEFAULT_URL=<developer-app-ios-url>
EXPO_PUBLIC_DEVELOPER_APP_ANDROID_DEFAULT_URL=<developer-app-android-url>

# Please note that the authenticator app-related URL is required only for the WSO2 Super App. 
# Since your app does not need it, you can safely remove those entries.
# Authenticator app related URLs
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=<google-ios-client-id>
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=<google-android-client-id>
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=<google-web-client-id>
EXPO_PUBLIC_GOOGLE_ACCESS_TOKEN_KEY=<google-access-token-key>
EXPO_PUBLIC_GOOGLE_REFRESH_TOKEN_KEY=<google-refresh-token-key>
EXPO_PUBLIC_GOOGLE_USER_INFO_KEY=<google-user-info-key>
EXPO_PUBLIC_GOOGLE_USER_INFO_URL=<google-user-info-url>
EXPO_PUBLIC_GOOGLE_TOKEN_URL=<google-token-url>
EXPO_PUBLIC_GOOGLE_DRIVE_UPLOAD_URL=<google-drive-upload-url>
EXPO_PUBLIC_GOOGLE_DRIVE_LIST_FILES_URL=<google-drive-list-url>
EXPO_PUBLIC_GOOGLE_TOKEN_INFO_URL=<google-token-info-url>
EXPO_PUBLIC_GOOGLE_DRIVE_FILE_DOWNLOAD_URL=<google-drive-file-download-url>
EXPO_PUBLIC_MICRO_APP_STORAGE_DIR=<directory-name-to-store-microapps>

# Local notifications related Configurations
# Local notifications storage key
# This key is used for persisting scheduled time-based notifications 
# (e.g., reminders before sessions, events, or other activities).
EXPO_PUBLIC_LOCAL_NOTIFICATIONS_KEY=<storage-key>

# Feed tab URLs
EXPO_PUBLIC_EVENTS_URL=<events-url>
EXPO_PUBLIC_NEWS_URL=<news-url>
EXPO_PUBLIC_LIBRARY_URL=<base-url-for-library-related-operations> 
EXPO_PUBLIC_ARTICLE_BASE_URL=<base-url-for-article-related-operations> 

# Android Notification Group definitions
# The following variables are mandatory if the app requires capabilities to display local (scheduled/unscheduled) or push notifications
EXPO_PUBLIC_NOTIFICATION_CHANNEL_ID=<notification-channel-id>
EXPO_PUBLIC_NOTIFICATION_CHANNEL_NAME=<notification-channel-name>

# Controls whether the Android notification icon is generated or not.
# Set to "true" to generate the small notification icon, "false" to skip it.
EXPO_PUBLIC_ADD_ANDROID_NOTIFICATION_ICON=<true/false>

# Defines the accent color for the Android small notification icon.
# This color appears behind the white silhouette of the notification icon.
EXPO_PUBLIC_ANDROID_NOTIFICATION_SMALL_ICON_ACCENT_COLOR=<hex-color>

# App Configurations
APP_NAME=<app-name>
APP_SLUG=<app-slug>
APP_SCHEME=<app-scheme>
APP_VERSION=1.0.0
APP_OWNER=<app-owner>
BUNDLE_IDENTIFIER=com.example.superapp  # For the iOS project
ANDROID_PACKAGE=com.example.superapp    # For the Android project

# ========== EAS Build & Over-the-air (OTA) updates ==========
# Required for EAS Build and EAS Update. Create a project at https://expo.dev and copy the project ID.
EAS_PROJECT_ID=<eas-project-id>

# Update channel baked into locally built binaries (Android/iOS).
# Must match the channel of the EAS build profile used to create the binary.
# Only two channels are supported: "development" or "production" (see eas.json).
# EAS cloud builds set the channel automatically from eas.json; set this when using
# `eas build --local` or `npx expo run:android` / `npx expo run:ios` after prebuild.
EXPO_PUBLIC_UPDATES_CHANNEL=development

# Google Sign-In (usually your REVERSED_CLIENT_ID from the iOS plist)
IOS_URL_SCHEME=com.googleusercontent.apps.xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sets up the firebase plugins/modules in the `app.config.ts`. Updating this value will require a prebuild
EXPO_PUBLIC_ENABLE_FIREBASE=<true/false>

# Firebase Remote Configuration
# When EXPO_PUBLIC_ENABLE_FIREBASE is true, the app fetches remote configuration from Firebase.
# Remote config values are managed in the Firebase Console, not in this .env file.
#
# Tab Visibility Rules (key: tab_visibility_rules):
# - Controls which tabs are visible based on user authentication and email domain.
# - Schema: See frontend/types/remoteConfig.types.ts
# - Default behavior is preserved if Remote Config fails or is disabled.
# - Fetch interval: Default Firebase behavior (can be configured via setConfigSettings)
#
# Note: To modify tab visibility rules, use Firebase Console > Remote Config > tab_visibility_rules
#
# Wallet Pass Enabled (key: wallet_pass_enabled):
# - Gates the business card entry point and its wallet action, per OS.
# - Schema: See frontend/types/remoteConfig.types.ts (WalletPassConfig)
#     {"ios":     {"enabled": true, "walletDownload": true},
#      "android": {"enabled": true, "walletDownload": false}}
#   Keyed by Platform.OS. `enabled` shows or hides the card icon in the Profile header and
#   fails open, so only a literal `false` hides it; `walletDownload` decides whether the
#   card sheet leads with "Add to Wallet" or "Save image" and fails closed, so only a
#   literal `true` turns it on. Per OS because the Apple .pkpass path and the Google
#   save-link path need separate certificates and separate console onboarding.
# - The legacy bare-boolean shape still works: {"ios": true} means
#   {"enabled": true, "walletDownload": true}, and false means walletDownload off.
# - Defaults to card visible, wallet download off (see frontend/types/remoteConfig.types.ts),
#   which is also what a build with Firebase disabled gets.
# - EXPO_PUBLIC_ENABLE_WALLET_PASS gates only `walletDownload`, never `enabled`; the business
#   card itself works without it. See frontend/README.md for the full table.
#
# Note: To modify wallet pass availability, use Firebase Console > Remote Config > wallet_pass_enabled

# ========== (Optional) Firebase config as a Base64 ==========
# This is a way to include the entire GoogleService-Info.plist or google-services.json
# in an environment variable, which can be useful for CI/CD environments.

# macOS: base64 -i path/to/your/GoogleService-Info.plist | tr -d '\n' | pbcopy
# Linux: base64 -w0 path/to/your/GoogleService-Info.plist | xclip -selection clipboard
# Windows: [Convert]::ToBase64String((Get-Content -Path "path\to\your\GoogleService-Info.plist" -Encoding Byte)) | Set-Clipboard
FIREBASE_IOS_PLIST_B64=<base-64-string>

# macOS: base64 -i path/to/your/google-services.json | tr -d '\n' | pbcopy
# Linux: base64 -w0 path/to/your/google-services.json | xclip -selection clipboard
# Windows: [Convert]::ToBase64String((Get-Content -Path "path\to\your\google-services.json" -Encoding Byte)) | Set-Clipboard
FIREBASE_ANDROID_JSON_B64=<base-64-string>
