{
  "name": "superapp-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx",
    "eas-build-pre-install": "npm run write-firebase-files",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx --fix",
    "lint:ci": "eslint --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "write-firebase-files": "npx --yes @dotenvx/dotenvx run -f .env -- node ./scripts/writeFirebaseFiles.ts",
    "postinstall": "patch-package && (npm run write-firebase-files || true) && npm install --prefix ..",
    "build:android:local": "EAS_LOCAL_BUILD_PLUGIN_PATH=$PWD/scripts/eas-local-build-plugin.sh npx --yes @dotenvx/dotenvx run -f .env -- eas build --platform android --local",
    "build:android:development:apk": "EAS_LOCAL_BUILD_PLUGIN_PATH=$PWD/scripts/eas-local-build-plugin.sh npx --yes @dotenvx/dotenvx run -f .env -- eas build -p android --profile development --local",
    "build:ios:development": "EAS_LOCAL_BUILD_PLUGIN_PATH=$PWD/scripts/eas-local-build-plugin.sh npx --yes @dotenvx/dotenvx run -f .env -- eas build --platform ios --profile development --local",
    "build:ios:production": "EAS_LOCAL_BUILD_PLUGIN_PATH=$PWD/scripts/eas-local-build-plugin.sh npx --yes @dotenvx/dotenvx run -f .env -- eas build --platform ios --profile production --local",
    "update:development": "npx --yes @dotenvx/dotenvx run -f .env -- eas update --platform android --channel development --environment development --message $MESSAGE && npx --yes @dotenvx/dotenvx run -f .env -- eas update --platform ios --channel development --environment development --message $MESSAGE",
    "update:production": "EAS_UPDATE_CHANNEL=production npx --yes @dotenvx/dotenvx run -f .env -- eas update --platform android --channel production --environment production --message $MESSAGE && EAS_UPDATE_CHANNEL=production npx --yes @dotenvx/dotenvx run -f .env -- eas update --platform ios --channel production --environment production --message $MESSAGE"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --max-warnings=0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^immer$": "<rootDir>/node_modules/immer/dist/cjs/index.js"
    }
  },
  "dependencies": {
    "@expo-google-fonts/sora": "^0.4.2",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/remote-config": "^23.8.8",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "@reduxjs/toolkit": "^2.5.1",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-auth-session": "~58.0.19",
    "expo-blur": "~58.0.6",
    "expo-brightness": "~58.0.3",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-mail-composer": "~58.0.4",
    "expo-navigation-bar": "~58.0.4",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.32",
    "expo-screen-orientation": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "expo-web-browser": "~58.1.0",
    "fast-xml-parser": "^5.2.3",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lottie-react-native": "~7.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-app-auth": "^9.0.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-keyboard-controller": "1.22.7",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paper": "^5.13.5",
    "react-native-qrcode-svg": "^6.3.21",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-view-shot": "6.1.1",
    "react-native-wallet-manager": "^2.2.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "14.0.1",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^20.2.0",
    "@react-native/jest-preset": "~0.88.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "@types/react-test-renderer": "~19.3.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "lint-staged": "^16.1.5",
    "patch-package": "^8.0.1",
    "react-test-renderer": "19.3.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
