{
  "name": "superapp-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx",
    "eas-build-pre-install": "npm run write-firebase-files",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx --fix",
    "lint:ci": "eslint --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "write-firebase-files": "npx dotenv -e .env -- node ./scripts/writeFirebaseFiles.ts",
    "postinstall": "npm run write-firebase-files || true && npm install --prefix ..",
    "build:android:local": "dotenv -- eas build --platform android --local",
    "build:android:development:apk": "dotenv -- eas build -p android --profile development --local"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --max-warnings=0"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
