{
  "name": "superapp-mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx",
    "eas-build-pre-install": "npm run write-firebase-files",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx --fix",
    "lint:ci": "eslint --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "write-firebase-files": "npx --yes @dotenvx/dotenvx run -f .env -- node ./scripts/writeFirebaseFiles.ts",
    "postinstall": "npm run write-firebase-files || true && npm install --prefix ..",
    "build:android:local": "npx --yes @dotenvx/dotenvx run -f .env -- eas build --platform android --local",
    "build:android:development:apk": "npx --yes @dotenvx/dotenvx run -f .env -- eas build -p android --profile development --local",
    "build:ios:development": "npx --yes @dotenvx/dotenvx run -f .env -- eas build --platform ios --profile development --local",
    "build:ios:production": "npx --yes @dotenvx/dotenvx run -f .env -- eas build --platform ios --profile production --local",
    "update:development": "npx --yes @dotenvx/dotenvx run -f .env -- eas update --platform android --channel development --message $MESSAGE && npx --yes @dotenvx/dotenvx run -f .env -- eas update --platform ios --channel development --message $MESSAGE",
    "update:production": "npx --yes @dotenvx/dotenvx run -f .env -- eas update --platform android --channel production --message $MESSAGE && npx --yes @dotenvx/dotenvx run -f .env -- eas update --platform ios --channel production --message $MESSAGE"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "eslint --fix --max-warnings=0"
  },
  "jest": {
    "preset": "jest-expo"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-firebase/app": "^23.8.8",
    "@react-native-firebase/messaging": "^23.8.8",
    "@react-native-firebase/remote-config": "^23.8.8",
    "@react-native-google-signin/google-signin": "^14.0.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@reduxjs/toolkit": "^2.5.1",
    "@tanstack/react-query": "^5.90.12",
    "axios": "^1.9.0",
    "date-fns": "^4.1.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.2.1",
    "expo": "~54.0.34",
    "expo-auth-session": "~7.0.11",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-camera": "~17.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-mail-composer": "~15.0.8",
    "expo-router": "~6.0.23",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-updates": "~29.0.17",
    "expo-web-browser": "~15.0.11",
    "fast-xml-parser": "^5.2.3",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lottie-react-native": "~7.3.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-app-auth": "^8.3.0",
    "react-native-edge-to-edge": "^1.7.0",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-markdown-display": "^7.0.2",
    "react-native-paper": "^5.13.5",
    "react-native-prompt-android": "^1.1.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "react-redux": "^9.2.0",
    "redux-persist": "^6.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@react-native-community/cli": "^18.0.0",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.1.10",
    "@types/react-test-renderer": "~19.1.0",
    "eslint": "^8.57.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "^29.2.1",
    "jest-expo": "~54.0.17",
    "lint-staged": "^16.1.5",
    "react-test-renderer": "19.1.0",
    "tsx": "^4.20.6",
    "typescript": "^5.3.3"
  },
  "private": true
}
